# CapitalDesk example environment. Placeholders only — never commit a real value.
#
# Secrets are REFERENCES (a file path or secret-manager URI), never the secret itself,
# and each class mounts into exactly one process role (ADR-0007).

# --- shared ------------------------------------------------------------------------
CAPITALDESK_ENV=local                              # local | testnet | production-read-only
CAPITALDESK_VENUE=binance-spot
CAPITALDESK_VENUE_BASE_URL=http://127.0.0.1:9443   # allowlisted per environment
CAPITALDESK_ACCOUNT_ALIAS=capitaldesk-local        # an operator label, not an identity
CAPITALDESK_BASELINE_EPOCH=1
CAPITALDESK_LOG_LEVEL=info
CAPITALDESK_BUILD_ID=dev
DATABASE_URL=postgres://localhost:5432/capitaldesk

# --- api only ----------------------------------------------------------------------
CAPITALDESK_API_PORT=3000
CAPITALDESK_OWNER_SESSION_SECRET_REF=file:///run/secrets/owner-session

# --- executor only -----------------------------------------------------------------
# Write capability starts disabled and cannot be enabled in production-read-only.
CAPITALDESK_WRITE_CAPABILITY=disabled
# CAPITALDESK_TRADE_CREDENTIAL_REF=file:///run/secrets/venue-trade
CAPITALDESK_SIGNED_REQUEST_VALIDITY_MS=5000
CAPITALDESK_CLOCK_SKEW_BUDGET_MS=1000
CAPITALDESK_AUTHORIZATION_DURABILITY=AT_RISK_SINGLE_NODE

# --- worker only -------------------------------------------------------------------
# CAPITALDESK_READ_CREDENTIAL_REF=file:///run/secrets/venue-read

# --- tests -------------------------------------------------------------------------
CAPITALDESK_TEST_DATABASE_URL=postgres://localhost:5432/capitaldesk_test
